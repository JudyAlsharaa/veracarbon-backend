# Anthropic API key — create at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Earth Engine service account email
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# Path to the downloaded JSON key file for the service account above
GEE_KEY_FILE=/path/to/gee-service-account-key.json

# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=https://veracarbon.com,http://localhost:3000

# GEE computation timeout in seconds (default: 120)
GEE_TIMEOUT_SECONDS=120

# Buffer radius around the project used for additionality baseline (metres)
ADDITIONALITY_BUFFER_METERS=5000

# Buffer radius used for leakage zone check (metres)
LEAKAGE_BUFFER_METERS=10000

# Maximum cloud cover % — scenes above this threshold are excluded
MAX_CLOUD_COVER_PCT=20
